includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests

    ignoreErrors:
        -
            # Faux positif : appelée par KernelTrait::getKernelParameters() via $this->getAllowedEnvs(),
            # PHPStan ne trace pas les appels à une méthode privée qui surcharge celle du trait.
            message: '#^Method App\\Kernel::getAllowedEnvs\(\) is unused\.$#'
            path: src/Kernel.php