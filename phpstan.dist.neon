includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests

    ignoreErrors:
        -
            # Faux positif : appelée par KernelTrait::getKernelParameters() via $this->getAllowedEnvs(),
            # PHPStan ne trace pas les appels à une méthode privée qui surcharge celle du trait.
            message: '#^Method App\\Kernel::getAllowedEnvs\(\) is unused\.$#'
            path: src/Kernel.php
        -
            # Fichier généré par la recipe Symfony Flex, pas du code du projet : le modifier
            # créerait une divergence avec la recipe à chaque mise à jour.
            message: '#^Call to function method_exists\(\) with ''Symfony\\\\Component\\\\Dotenv\\\\Dotenv'' and ''bootEnv'' will always evaluate to true\.$#'
            path: tests/bootstrap.php