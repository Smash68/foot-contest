{
    "require": {
        "php": "^8.4",
        "symfony/framework-bundle": "^8.1",
        "symfony/console": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/flex": "^2.11",
        "symfony/runtime": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "doctrine/orm": "^3.6",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "lexik/jwt-authentication-bundle": "^3.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/browser-kit": "^8.1",
        "dama/doctrine-test-bundle": "^8.6",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "deptrac/deptrac": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text",
        "stan": "phpstan analyse --memory-limit=1G",
        "deptrac": "deptrac analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
