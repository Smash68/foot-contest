{
    "require": {
        "php": "^8.4",
        "symfony/framework-bundle": "^8.1",
        "symfony/console": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/flex": "^2.11",
        "symfony/runtime": "^8.1",
        "symfony/dotenv": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "symfony/phpunit-bridge": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
